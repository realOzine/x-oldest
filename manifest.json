{
  "manifest_version": 3,
  "name": "X Oldest",
  "description": "Read an X user's posts from oldest to newest, right on their profile page.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["src/engine/transport.js", "src/engine/normalize.js", "src/engine/reader.js", "src/engine/api.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["src/store.js", "src/ui/i18n.js", "src/ui/cards.js", "src/ui/page.js", "src/ui/view.js", "src/ui/app.js"],
      "css": ["src/ui/ui.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
